# Copie para .env e preencha. O .env nunca vai para o git.

# Chave da API da Anthropic (https://console.anthropic.com) - usada na extração dos editais
ANTHROPIC_API_KEY=

# Modelo e esforço da extração (Haiku é o mais barato; troque para claude-sonnet-5-5 se a qualidade pedir)
EXTRACTOR_MODEL=claude-haiku-5-5
EXTRACTOR_EFFORT=low

# Token do bot: fale com o @BotFather no Telegram e use /newbot
TELEGRAM_BOT_TOKEN=

# Cadastro gratuito em https://inlabs.in.gov.br (necessário para o DOU)
INLABS_EMAIL=
INLABS_PASSWORD=

# Fontes ativas e intervalo entre ciclos do worker
FONTES=dodf,dou
INTERVALO_COLETA_MIN=10

# Limite de filtros no plano gratuito
MAX_FILTROS_FREE=3
